<%- include('../partials/header', { pageTitle }) %>

<section>
  <h1>Daftar Film</h1>

  <nav class="filter" aria-label="Filter genre">
    <a href="/"<%- genreDipilih === '' ? ' aria-current="page"' : '' %>>Semua</a>
    <% genre.forEach(item => { %>
      <a href="/?genre=<%= encodeURIComponent(item.toLowerCase()) %>"<%- genreDipilih === item.toLowerCase() ? ' aria-current="page"' : '' %>><%= item %></a>
    <% }) %>
  </nav>

  <p class="info">Menampilkan <%= film.length %> film<% if (genreDipilih) { %> dengan genre <strong><%= genreDipilih %></strong><% } %>.</p>

  <% if (film.length === 0) { %>
    <p class="info">TIDAK ADA FILM DI GENRE INI!.</p>
  <% } else { %>
    <ul class="movie-grid">
      <% film.forEach(item => { %>
        <li class="movie">
          <a href="/item/<%= item.id %>">
            <img class="movie-poster" src="<%= item.poster %>" alt="Poster film <%= item.judul %>" width="400" height="300" loading="lazy">
            <div class="movie-info">
              <h2 class="movie-title"><%= item.judul %></h2>
              <p class="movie-meta"><%= item.genre %> | <%= item.tahun %></p>
            </div>
          </a>
        </li>
      <% }) %>
    </ul>
  <% } %>
</section>

<%- include('../partials/footer') %>